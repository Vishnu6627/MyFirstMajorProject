<% layout("/layouts/boilerplate") %>
<body>
    <p><%= object.title %></p>
    <p><%= object.description %></p>
    <p><%= object.price %></p>
    <p><%= object.location %></p>
    <p><%= object.country %></p>
    <form method="get" action="/listings/edit/<%= object._id %>" ><button >EDIT</button></form>
    <form action="/listings" method="get">
        <button>Back</button>
    </form>
    <form action="/listings/<%= object._id %>?_method=DELETE" method="post">
        <button>Delete</button>
    </form>




    <div class="col-8 offset-3 mb-3">
    <hr />
    <h4>Leave a Review</h4>
    <form action="/listings/<%= object._id %>/reviews"  method="post">
    <div class="mb-3 mt-3">
      <label for="rating" class="form-label">Rating</label>
      <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range" />
    </div>
    <div class="mb-3 mt-3">
      <label for="comment" class="form-label">Comments</label>
      <textarea
        name="review[comment]"
        id="comment"
        cols="30"
        rows="5"
        class="form-control"
      ></textarea>
    </div>
    <button class = "btn btn-outline-dark"> Submit</button>
    </form>

    <p><b>All Reviews</b></p>
    <div class="row">
    <% for(i of object.reviews){ %>
        <div class="card col-5 ms-3 mb-3">
            <div class="card-body">
                <h5 class="card-title">John Doe</h5>
                <p class="card-text"><%= i.comment %></p>
                <p class="card-text"><%= i.rating %> stars</p>
            </div>
            <form 
            class="mb-3 ms-3" 
            method="POST" 
            action="/listings/<%= object._id %>/reviews/<%= i._id %>?_method=DELETE"
            >
            <button class="btn btn-sm btn-dark">Delete</button>
        </form>
        </div>
        
    
    <% } %>
    </div>
    



    </div>
</body>
 